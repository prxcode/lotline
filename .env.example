SAMPLE_MODE=true
LOG_LEVEL=INFO
PORT=8000
DB_PATH=lotline.db

# Data layer: "local" reads the CSVs in DATA_DIR through DuckDB; "zetaris" sends SQL to Zetaris over REST
DATA_BACKEND=local
DATA_DIR=data
# If Zetaris is unreachable, continue on the local copy and report it
DATA_FALLBACK=true

# Zetaris: create the API key in the Zetaris web interface
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_BASE_URL=http://localhost:3000
# Logical name = table registered in Zetaris, comma separated
ZETARIS_TABLES=inventory=lotline_warehouse.inventory,distributions=lotline_distribution.distributions,agencies=lotline_distribution.agencies,recalls=lotline_recalls.recalls,recall_products=lotline_recalls.recall_products
# The PostgreSQL behind Zetaris (zetaris/docker-compose.yml); local only
LOTLINE_DB_PASSWORD=lotline-local-only

# Power, route 1: Meterless Runtime (Nightshift). Found automatically on 127.0.0.1:8088/8090/8787/11434 when running.
METERLESS_ENABLED=true
METERLESS_BASE_URL=
METERLESS_RUNTIME_TOKEN=your-meterless-runtime-token
# Or point at the runtime's state directory; its proxy-token file is read
METERLESS_STATE_DIR=
# Empty = first model the runtime lists, e.g. meterless/reasoning
METERLESS_MODEL=

# Power, route 2: NVIDIA's API (build.nvidia.com)
NVIDIA_API_KEY=your-nvapi-key
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# meterless (default) tries Meterless Runtime first; nvidia tries NVIDIA first
MODEL_PROVIDER=meterless
# If no model answers, continue on the rules and report it
LLM_FALLBACK=true

# FastAPI: set any value to require an X-API-Key header; leave blank for local use
API_KEY=
CORS_ORIGINS=*
